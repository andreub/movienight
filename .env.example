# Copy to .env and fill in. .env is git-ignored and never baked into the image.

# Data directory inside the container (SQLite db, image cache). Leave as-is in Docker.
MOVIENIGHT_DATA_DIR=

# Unpacked Letterboxd export folder, imported at start if present or changed.
MOVIENIGHT_LETTERBOXD_DIR=

# Letterboxd username for the RSS sync. If empty, read from profile.csv of the export.
MOVIENIGHT_LETTERBOXD_USER=

# TMDB credential. Starts with "eyJ" = v4 bearer token; otherwise v3 API key.
# Empty = degraded mode (Plex metadata only).
MOVIENIGHT_TMDB_TOKEN=

# Optional pre-set Plex token. Otherwise connect via PIN login in the UI.
MOVIENIGHT_PLEX_TOKEN=

# Background sync interval in hours (default 6).
MOVIENIGHT_SYNC_HOURS=

# 1 = marks films you flag "seen it" as played on your Plex servers (writes to your Plex account). Default off.
MOVIENIGHT_PLEX_PUSH_SEEN=

# Compose only: host port to publish (default 8080).
MOVIENIGHT_PORT=

# Compose only: container timezone (default Europe/Madrid).
TZ=

# Optional login with an OpenID Connect provider (Pocket ID, Authelia, Keycloak…): a public
# client with PKCE and the redirect <MOVIENIGHT_PUBLIC_URL>/login/callback.
# Empty issuer = no login. With an issuer but no client id the app answers 503 (never open).
MOVIENIGHT_PUBLIC_URL=
MOVIENIGHT_OIDC_ISSUER=
MOVIENIGHT_OIDC_CLIENT_ID=
# comma-separated `sub` claims allowed in; empty = anyone the provider signs in
MOVIENIGHT_OIDC_ALLOWED_SUBS=

# Optional AI chat: hidden until the chosen provider is fully configured.
# Provider: anthropic (default) or openai (= any OpenAI-compatible endpoint). Blank + a base URL = openai.
MOVIENIGHT_AI_PROVIDER=
# anthropic: the key; the model defaults to claude-opus-5-5
ANTHROPIC_API_KEY=
# model id (required for openai; must support streaming tool calls)
MOVIENIGHT_AI_MODEL=
# openai provider only: endpoint, key, prices in USD per 1M tokens (blank = 0, free tier) and the
# reply cap per request (blank = 2048)
MOVIENIGHT_AI_BASE_URL=
MOVIENIGHT_AI_API_KEY=
MOVIENIGHT_AI_PRICE_INPUT=
MOVIENIGHT_AI_PRICE_OUTPUT=
MOVIENIGHT_AI_MAX_TOKENS=
# Example, Groq free tier (key from console.groq.com; prompts go to Groq, see README > Privacy):
# MOVIENIGHT_AI_PROVIDER=openai
# MOVIENIGHT_AI_BASE_URL=https://api.groq.com/openai/v1
# MOVIENIGHT_AI_API_KEY=gsk_...
# MOVIENIGHT_AI_MODEL=openai/gpt-oss-120b
# monthly chat budget in USD (estimate from prices); 0 = no limit; blank = 2.00.
# A hard cap can also be set in the provider's console.
MOVIENIGHT_AI_MONTHLY_BUDGET_USD=2.00
